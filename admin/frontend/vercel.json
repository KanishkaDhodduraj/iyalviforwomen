{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-ADMIN-API-VERCEL-DOMAIN/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REPLACE-WITH-ADMIN-API-VERCEL-DOMAIN/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
